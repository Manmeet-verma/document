# Copy to .env and adjust. The .env file is NOT committed to git.

# Web server settings (used by run.py)
HOST=127.0.0.1
PORT=8000

# Data directories (used by backend/app.py)
# DATA_ROOT=         path to a folder containing input/, output/, runs/

# OCR settings
# OCR_ENGINE=        easyocr | rapidocr   (auto-detects if unset)